# Optional ceilings, not a measured throughput guarantee. Review RAM and UDP
# drop counters first. Do not lower larger existing values or raise per-socket
# defaults blindly on small servers. Back up current values before applying.
net.core.rmem_max = 33554432
net.core.wmem_max = 33554432
# BBR/fq require kernel support; uncomment only after inspecting the host.
# net.core.default_qdisc = fq
# net.ipv4.tcp_congestion_control = bbr
# TFO also requires application support; enabling this alone is not sufficient.
# net.ipv4.tcp_fastopen = 3
