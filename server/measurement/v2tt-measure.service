[Unit]
Description=V2TT bounded measurement endpoint
After=network.target

[Service]
ExecStart=/usr/local/lib/v2tt-measure
Restart=on-failure
DynamicUser=yes
SupplementaryGroups=sing-box
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
